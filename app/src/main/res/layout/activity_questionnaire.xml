<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".QuestionnaireActivity">

    <ScrollView
        android:layout_width="409dp"
        android:layout_height="729dp"
        android:layout_marginStart="1dp"
        android:layout_marginTop="1dp"
        android:layout_marginEnd="1dp"
        android:layout_marginBottom="1dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" >

            <LinearLayout
                android:id="@+id/linearLayoutHeader"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginBottom="11dp"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/imgIcn"
                    android:layout_width="359dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    app:srcCompat="@drawable/krepco_icn" />

                <TextView
                    android:id="@+id/tvSlogan"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:text="@string/Slogan"
                    android:textSize="20sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/linearLayoutQuestionnaire"
                android:layout_width="match_parent"
                android:layout_height="570dp"
                android:orientation="vertical">

                <ImageButton
                    android:id="@+id/btnQst1"
                    android:layout_width="291dp"
                    android:layout_height="94dp"
                    android:layout_gravity="center"
                    app:srcCompat="@drawable/btn_quest1" />

                <ImageButton
                    android:id="@+id/btnQst2"
                    android:layout_width="291dp"
                    android:layout_height="94dp"
                    android:layout_gravity="center"
                    app:srcCompat="@drawable/btn_quest2" />

                <ImageButton
                    android:id="@+id/btnQst3"
                    android:layout_width="291dp"
                    android:layout_height="94dp"
                    android:layout_gravity="center"
                    app:srcCompat="@drawable/btn_quest3" />

                <ImageButton
                    android:id="@+id/btnQst4"
                    android:layout_width="292dp"
                    android:layout_height="94dp"
                    android:layout_gravity="center"
                    app:srcCompat="@drawable/btn_quest4" />

                <ImageButton
                    android:id="@+id/btnQst5"
                    android:layout_width="290dp"
                    android:layout_height="94dp"
                    android:layout_gravity="center"
                    app:srcCompat="@drawable/btn_quest5" />

                <ImageButton
                    android:id="@+id/btnQst6"
                    android:layout_width="292dp"
                    android:layout_height="97dp"
                    android:layout_gravity="center"
                    app:srcCompat="@drawable/btn_quest6" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/linearLayoutBack"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnBack"
                    android:layout_width="411dp"
                    android:layout_height="60dp"
                    android:layout_gravity="center"
                    android:layout_marginEnd="4dp"
                    android:background="@null"
                    android:backgroundTint="#3E4041"
                    android:text="@string/btn_back1"
                    android:textColor="#FFFFFF"
                    android:textSize="24sp"
                    app:cornerRadius="0dp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>